package dashboard

templ ViewCompleteUserInfoSuccess(redirect string) {
  <div class="h-full flex items-center justify-center pb-[10vh]">
    <div class="flex flex-col space-y-8 card w-96 bg-base-100 shadow-xl px-8 py-10">
      <div class="text-center">
        <div class="flex justify-center">
          <i class="h-24 w-24" color="green" data-feather="check-circle"></i>
        </div>
        <h1 class="text-2xl">Informasi user berhasil disimpan</h1>
      </div>
      <div class="text-center">
        if redirect == "" {
          <a href="/dashboard" class="btn btn-primary w-full">OK</a>
        } else {
          <a href={templ.URL(redirect)} class="btn btn-primary w-full">OK</a>
        }
      </div>
    </div>
  </div>
}
