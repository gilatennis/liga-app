package profile

import (
  "liga-app/infra/http/htmx/common/layouts"
)

templ PageProfileDetail(vmodel *VModelPageProfileDetail) {
  @layouts.DashboardLayout("Profile", vmodel.User, layouts.FOOTER_MENU_PROFILE) {
    <div class="flex flex-col items-center space-y-2">
      if vmodel.User.ProfilePictureURL == "" {
        <div class="avatar placeholder">
          <div class="bg-primary text-neutral-content w-36 rounded-full">
            <span class="text-5xl">{string(vmodel.User.Name[0])}</span>
          </div>
        </div>
      } else {
        <div class="avatar">
          <div class="w-36 rounded-full">
            <img src={vmodel.User.ProfilePictureURL} />
          </div>
        </div>
      }

      <div class="space-y-2 flex flex-col items-center">
        <h1 class="text-3xl">{vmodel.User.Name}</h1>
        <div class="flex items-center space-x-2">
          <i data-feather="mail" class="w-4 h-4"></i>
          <h3>{vmodel.User.Email}</h3>
        </div>
        <div class="flex items-center space-x-2">
          <img alt="whatsapp" src="/static/icons/whatsapp.png" class="w-5 h-5" />
          <h3>{vmodel.User.Phone}</h3>
        </div>
      </div>

      <div class="pt-4">
        <a href="/dashboard/profile/edit" class="btn btn-secondary btn-wide">Edit Profile</a>
      </div>
    </div>
  }
}
