templ PageMatchScheduleTimes(vmodel VModelPageMatchScheduleTimes) {
  @layouts.DashboardLayout("Pilih Venue", vmodel.User, layouts.FOOTER_MENU_LEAGUE) {
    <div class="space-y-8">
      @league.ViewLeagueDetail(vmodel.League, false)
      @components.PageHeader("Pilih Waktu Bertanding")
      <div class="space-y-4">
        <h1 class="text-xl font-bold">{vmodel.Venue.Name}</h1>
        <h2 class="text-lg font-bold mt-4">{vmodel.Court.Name}</h2>
      </div>
      <div class="sticky">
        <h2>
          {monday.Format(vmodel.Day, "Monday 2 January 2006", monday.LocaleIdID)}
        </h2>
      </div>
      @ViewSelectTimes(vmodel)
    </div>
  }
}

templ ViewSelectTimes(vmodel VModelPageMatchScheduleTimes) {
  <div class="flex flex-col space-y-8">
    if vmodel.League.ParticipationCategory == enums.CATEGORY_PARTICIPATION_TEAMS {
      for _, ts := range groupTimeSlotsForTeamSchedule(vmodel.TimeSlots) {
        <div class="card w-auto shadow-xl ">
          <div class="p-4 flex flex-col space-y-2">
            <p>{ts.Start.Format("15:04")} - {ts.End.Format("15:04")}</p>
            if ts.IsAvailable {
              <p class="text-success font-bold">AVAILABLE</p>
              <button
                hx-confirm={confirmMessageSelectSchedule(ts.Start, ts.End)}
                hx-post={urlPostMatchScheduleRequest(vmodel.League.UUID, vmodel.Match.UUID, vmodel.Venue.UUID, vmodel.Court.UUID)}
                hx-swap="none"
                name="timeslot_uuids"
                value={valuePostMatchScheduleRequest(ts.TimeSlots)}
                class="btn btn-primary btn-sm w-full"
              >
                PILIH TIMESLOT
              </button>
            } else {
              <p class="text-error font-bold">UNAVAILABLE</p>
              if ts.Match != nil {
                <div class="flex flex-row justify-between space-x-6 items-center">
                  <div class="flex-3 text-sm">{ts.Match.TeamA.Name}</div>
                  <div class="flex-1">VS</div>
                  <div class="flex-3 text-sm">{ts.Match.TeamB.Name}</div>
                </div>
              } else {
                <p class="text-sm text-neutral-600">Pertandingan beregu perlu waktu minimal 2 jam</p>
              }
            }
          </div>
        </div>
      }
    } else {
      for _, ts := range vmodel.TimeSlots {
        <div class="card w-auto shadow-xl ">
          <div class="p-4 flex flex-col space-y-2">
            <p>{ts.Start.Format("15:04")} - {ts.End.Format("15:04")}</p>
            if ts.Match == nil {
              <p class="text-success font-bold">AVAILABLE</p>
              <button
                hx-confirm={confirmMessageSelectSchedule(ts.Start, ts.End)}
                hx-post={urlPostMatchScheduleRequest(vmodel.League.UUID, vmodel.Match.UUID, vmodel.Venue.UUID, vmodel.Court.UUID)}
                hx-swap="none"
                name="timeslot_uuids"
                value={valuePostMatchScheduleRequest([]entities.CourtTimeSlot{ts})}
                class="btn btn-primary btn-sm w-full"
              >
                PILIH TIMESLOT
              </button>
            } else {
              <p class="text-error font-bold">UNAVAILABLE</p>
            }
          </div>
        </div>
      }
    }
  </div>
}

type TeamScheduleTimeSlot struct {
  TimeSlots []entities.CourtTimeSlot
  Start time.Time
  End time.Time
  Match *entities.Match
  IsAvailable bool
}

func groupTimeSlotsForTeamSchedule(timeslots []entities.CourtTimeSlot) []TeamScheduleTimeSlot {
  // pp.Println(timeslots)
  teamScheduleTimeSlots := []TeamScheduleTimeSlot{}
  curr := TeamScheduleTimeSlot{}

  i := 0
  for {
    if i > len(timeslots) - 1 {
      break
    }

    ts := timeslots[i]

    // Match exists in timeslot
    if ts.Match != nil {
      fmt.Println("A")
      curr.Match = ts.Match
      curr.TimeSlots = append(curr.TimeSlots, ts)
      curr.IsAvailable = false
      curr.Start = ts.Start
      curr.End = ts.End
      teamScheduleTimeSlots = append(teamScheduleTimeSlots, curr)
      // reset
      curr = TeamScheduleTimeSlot{}

      i += 1
      continue
    }

    // Last 2 timeslots, can not be used, because we need 3 timeslots
    if i + 1 == len(timeslots) - 1 {
      fmt.Println("B")
      for j := i; j < len(timeslots); j++ {
        ts := timeslots[j]
        curr.Match = ts.Match
        curr.TimeSlots = append(curr.TimeSlots, ts)
        curr.IsAvailable = false
        curr.Start = ts.Start
        curr.End = ts.End
        teamScheduleTimeSlots = append(teamScheduleTimeSlots, curr)
        // reset
        curr = TeamScheduleTimeSlot{}
      }
      break
    }

    tsPlus1 := timeslots[i+1]
    tsPlus2 := timeslots[i+2]

    if tsPlus1.Match == nil && tsPlus2.Match == nil {
      fmt.Println("C")
      curr.TimeSlots = []entities.CourtTimeSlot{ts, tsPlus1, tsPlus2}
      curr.Start = ts.Start
      curr.End = tsPlus2.End
      curr.IsAvailable = true
      teamScheduleTimeSlots = append(teamScheduleTimeSlots, curr)
      // reset
      curr = TeamScheduleTimeSlot{}

    } else {
      fmt.Println("D")
      for _, x := range []entities.CourtTimeSlot{ts, tsPlus1, tsPlus2} {
        curr.Match = x.Match
        curr.TimeSlots = append(curr.TimeSlots, x)
        curr.IsAvailable = false
        curr.Start = x.Start
        curr.End = x.End
        teamScheduleTimeSlots = append(teamScheduleTimeSlots, curr)
        // reset
        curr = TeamScheduleTimeSlot{}
      }
    }

    i += 3
    continue
  }

  // pp.Println(teamScheduleTimeSlots)

  return teamScheduleTimeSlots
}

func urlPostMatchScheduleRequest(leagueUUID, matchUUID, venueUUID, courtUUID uuid.UUID) string {
  return fmt.Sprintf("/dashboard/leagues/%s/matches/%s/schedule/venues/%s/courts/%s/times",
    leagueUUID,
    matchUUID,
    venueUUID,
    courtUUID,
  )
}

func valuePostMatchScheduleRequest(tslots []entities.CourtTimeSlot) string {
  timeslotUUIDs := []string{}
  for _, ts := range tslots {
    timeslotUUIDs = append(timeslotUUIDs, ts.UUID.String())
    // timeslotUUIDs = append(timeslotUUIDs, uuid.New().String())
  }

  val := strings.Join(timeslotUUIDs, ",")
  return val
}

func confirmMessageSelectSchedule(start, end time.Time) string {
  return fmt.Sprintf("Konfirmasi pilih jadwal %s - %s", start.Format("15:04"), end.Format("15:04"))
}
