package match

import (
  "liga-app/infra/http/htmx/common/layouts"
  // "liga-app/infra/http/htmx/common/components"
  "liga-app/infra/http/htmx/dashboard/league"
  "liga-app/entities"
  // "liga-app/enums"
  "strconv"
	"github.com/google/uuid"
  "fmt"
	"liga-app/infra/http/htmx/common/components"
	// "github.com/goodsign/monday"
)

templ PageMatchList(vmodel *VModelPageMatchList) {
  @layouts.DashboardLayout("Tim", vmodel.User, layouts.FOOTER_MENU_LEAGUE) {
    <div class="space-y-8">
      @league.ViewLeagueDetail(vmodel.League, false)
      @components.PageHeader("Daftar Pertandingan", fmt.Sprintf("/dashboard/leagues/%s", vmodel.League.UUID))
      @ViewFilterMatchList()
      @ViewMatchList(vmodel.League.UUID, vmodel.Matches, vmodel.MatchesNextPage)
    </div>
  }
}

script onOptionChange() {
  const target = "#view-match-list"
  const event = "refetch-list"
  htmx.trigger(target, event)
}

templ ViewFilterMatchList() {
  <div id="filter-match-list" class="flex flex-row space-x-4">
    @components.InputSelect(components.InputSelectParams{
      Label: "Status Pertandingan",
      Name: "match_status",
      SelectedValue: "ALL",
      JS_OnChange: onOptionChange(),
      Options: []components.InputSelectOption{
        {
          Text: "Semua",
          Value: "ALL",
        },
        {
          Text: "Ronde Ini",
          Value: "CURRENT_ROUND",
        },
        {
          Text: "Akan Datang",
          Value: "UPCOMING",
        },
        {
          Text: "Selesai",
          Value: "COMPLETED",
        },
        {
          Text: "Overdue",
          Value: "OVERDUE",
        },
      },
    })
    @components.InputSelect(components.InputSelectParams{
      Label: "Peserta Pertandingan",
      Name: "match_participant",
      SelectedValue: "ME",
      JS_OnChange: onOptionChange(),
      Options: []components.InputSelectOption{
        {
          Text: "Semua",
          Value: "ALL",
        },
        {
          Text: "Pertandingan Saya",
          Value: "ME",
        },
      },
    })
  </div>
}

func urlGetMatchListView(leagueUUID uuid.UUID) string {
  return fmt.Sprintf("/dashboard/leagues/%s/matches/view", leagueUUID)
}

func urlLoadMoreMatches(leagueUUID uuid.UUID, page int) string {
  return fmt.Sprintf("/dashboard/leagues/%s/matches/view?page=%d", leagueUUID, page)
}

templ ViewMatchList(leagueUUID uuid.UUID, matches []entities.Match, nextPage int) {
  <div
    class="flex flex-col space-y-2"
    id="view-match-list"
    hx-trigger="refetch-list"
    hx-get={urlGetMatchListView(leagueUUID)}
    hx-include="#filter-match-list"
    hx-swap="outerHTML"
  >
    for _, m := range matches {
      @ViewMatchCard(m)
    }
    if nextPage > 0 {
      <div id="load-more-replace"> 
        <button
          class="btn btn-primary w-full"
          hx-get={urlLoadMoreMatches(leagueUUID, nextPage)}
          hx-target="#load-more-replace"
          hx-swap="outerHTML"
          hx-include=""
        >
          Load More
        </button>
      </div>
    }
  </div>

}

templ ViewMoreMatches(leagueUUID uuid.UUID, matches []entities.Match, nextPage int) {
  for _, m := range matches {
    @ViewMatchCard(m)
  }
  if nextPage > 0 {
    <div id="load-more-replace"> 
      <button
        class="btn btn-primary w-full"
        hx-get={urlLoadMoreMatches(leagueUUID, nextPage)}
        hx-target="#load-more-replace"
        hx-swap="outerHTML"
        hx-include=""
      >
        Load More
      </button>
    </div>
  }
}

templ ViewMatchCard(m entities.Match) {
  <a
    hx-boost="false"
    if m.TeamA != nil && m.TeamB != nil {
      href={hrefMatchDetail(m.LeagueUUID, m.UUID)}
    }
  >
    <div class="card w-auto shadow-xl">
      <div class="p-4 space-y-2">
        <div class="flex flex-row">
          if m.FilterStatus == "COMPLETED" {
            <div class="flex-1 text-left text-success font-bold">{m.FilterStatus}</div>
          } else if m.FilterStatus == "NO SCHEDULE" {
            <div class="flex-1 text-left text-secondary font-bold">{m.FilterStatus}</div>
          } else {
            <div class="flex-1 text-left text-primary font-bold">{m.FilterStatus}</div>
          }
          <div class="flex-1">
            <div class="text-left text-secondary font-bold">Pertandingan ke {strconv.Itoa(m.Round.Number)}</div>
            /*
            if m.Round.Start != nil && m.Round.End != nil {
              <div class="text-xs">{monday.Format(*m.Round.Start, "02/01/2006", monday.LocaleIdID)} - {monday.Format(*m.Round.End, "02/01/2006", monday.LocaleIdID)}</div>
            }
            */
          </div>
        </div>
        <div class="flex">
          if m.TeamA == nil {
            <div class="w-[40%] text-sm">-</div>
          } else {
            <div class="w-[40%] text-sm">{m.TeamA.Name}</div>
          }
          <div class="w-[10%] text-center">VS</div>
          if m.TeamB == nil {
            <div class="w-[40%] text-sm">-</div>
          } else {
            <div class="w-[40%] text-sm pl-2">{m.TeamB.Name}</div>
          }
        </div>
        if m.FilterStatus == "COMPLETED" {
          <div class="flex">
            if matchTeamWinOrLose(&m, "A") == "W" {
              <div class="w-[40%] text-left text-success font-bold">{matchTeamWinOrLose(&m, "A")}</div>
            } else if matchTeamWinOrLose(&m, "A") == "L" {
              <div class="w-[40%] text-left text-error font-bold">{matchTeamWinOrLose(&m, "A")}</div>
            } 

            <div class="w-[10%]"></div>

            if matchTeamWinOrLose(&m, "B") == "W" {
              <div class="w-[40%] text-left text-success font-bold pl-2">{matchTeamWinOrLose(&m, "B")}</div>
            } else if matchTeamWinOrLose(&m, "B") == "L" {
              <div class="w-[40%] text-left text-error font-bold pl-2">{matchTeamWinOrLose(&m, "B")}</div>
            } 
          </div>
        }
      </div>
    </div>
  </a>
}

func hrefMatchDetail(leagueUUID uuid.UUID, matchUUID uuid.UUID) templ.SafeURL {
  return templ.URL(fmt.Sprintf("/dashboard/leagues/%s/matches/%s", leagueUUID, matchUUID))
}

func matchTeamWinOrLose(match *entities.Match, aOrB string) string {
  setsWonA := 0
  setsWonB := 0
  for _, s := range match.Sets {
    if s.TeamAScore > s.TeamBScore {
      setsWonA += 1
    }
    if s.TeamBScore > s.TeamAScore {
      setsWonB += 1
    }
  }

  if aOrB == "A" {
    if setsWonA > setsWonB {
      return "W"
    }
    if setsWonB > setsWonA {
      return "L"
    }
  }

  if aOrB == "B" {
    if setsWonA > setsWonB {
      return "L"
    }
    if setsWonB > setsWonA {
      return "W"
    }
  }

  return "-"
}
