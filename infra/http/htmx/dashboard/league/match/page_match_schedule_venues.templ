package match

import (
  "liga-app/infra/http/htmx/common/layouts"
  // "liga-app/infra/http/htmx/common/components"
  "liga-app/infra/http/htmx/dashboard/league"
  "liga-app/entities"
  // "liga-app/enums"
  // "strconv"
	// "github.com/google/uuid"
  "fmt"
	"liga-app/infra/http/htmx/common/components"
	// "liga-app/entities"
  // "time"
	// "liga-app/enums"
	"github.com/google/uuid"
)

templ PageMatchScheduleVenues(vmodel VModelPageMatchScheduleVenues) {
  @layouts.DashboardLayout("Pilih Venue", vmodel.User, layouts.FOOTER_MENU_LEAGUE) {
    <div class="space-y-8">
      @league.ViewLeagueDetail(vmodel.League, false)
      @components.PageHeader("Pilih Tempat Bertanding", "")
      @ViewSelectVenue(vmodel)
    </div>
  }
}

templ ViewSelectVenue(vmodel VModelPageMatchScheduleVenues) {
  <div class="flex flex-col space-y-4">
    for _, v := range vmodel.Venues {
      @ViewVenueCard(v, *vmodel.Match)
    }
    @ViewUseOwnVenue(vmodel.League.UUID, vmodel.Match.UUID)
  </div>
}

templ ViewVenueCard(v entities.Venue, m entities.Match) {
  <a hx-boost="false" href={hrefSelectCourt(m.LeagueUUID, m.UUID, v.UUID)}>
    <div class="card card-side bg-base-100 shadow-xl w-auto">
      <figure>
        <img class="h-full object-cover" src={v.Image} alt={v.Name} />
      </figure>
      <div class="p-4">
        <h2 class="card-title">{v.Name}</h2>
        <p>{v.Address}</p>
        /*
        <div class="card-actions justify-end">
          <button class="btn btn-primary">Watch</button>
        </div>
        */
      </div>
    </div>
  </a>
}

func hrefSelectCourt(leagueUUID, matchUUID, venueUUID uuid.UUID) templ.SafeURL {
  return templ.URL(fmt.Sprintf("/dashboard/leagues/%s/matches/%s/schedule/venues/%s/courts", leagueUUID, matchUUID, venueUUID))
}

templ ViewUseOwnVenue(leagueUUID, matchUUID uuid.UUID) {
  <a hx-boost="false" href={hrefUseOwnVenue(leagueUUID, matchUUID)}>
    <div class="card card-side bg-base-100 shadow-xl w-auto p-4">
      <figure>
        <i data-feather="book-open" class="text-secondary w-8 h-8"></i>
      </figure>
      <div class="p-4 w-full">
        <h2 class="card-title w-full text-center">Booking Lapangan Sendiri</h2>
      </div>
    </div>
  </a>
}

func hrefUseOwnVenue(leagueUUID, matchUUID uuid.UUID) templ.SafeURL {
  return templ.URL(fmt.Sprintf("/dashboard/leagues/%s/matches/%s/schedule/venues/use-own-venue", leagueUUID, matchUUID))
}
