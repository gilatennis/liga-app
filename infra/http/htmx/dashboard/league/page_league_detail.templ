package league

import (
  "liga-app/infra/http/htmx/common/layouts"
	"github.com/google/uuid"
  "fmt"
)

templ PageLeagueDetail(vmodel *VModelPageLeagueDetail) {
  @layouts.DashboardLayout("Daftar Liga", vmodel.User, layouts.FOOTER_MENU_LEAGUE) {
    <div class="space-y-8">
      @ViewLeagueDetail(vmodel.League)
      <!-- Join Button -->
      <div>
        <a href={hrefLeagueRegistration(vmodel.League.UUID)} class="btn btn-primary w-full btn-lg">Daftar ke liga ini!</a>
      </div>

      <div class="grid grid-cols-2 gap-2">
        <div class="card w-auto btn h-full shadow-xl">
          <div class="grid grid-row-2 gap-4 p-4">
            <div class="flex justify-center text-primary">
              <i data-feather="users" width="32" height="32"></i>
            </div>
            <h3 class="text-center">List Pemain</h3>
          </div>
        </div>
        <div class="card w-auto btn h-full shadow-xl">
          <div class="grid grid-row-2 gap-4 p-2">
            <div class="flex justify-center text-primary">
              <i data-feather="list" width="32" height="32"></i>
            </div>
            <h3 class="text-center">List Pertandingan</h3>
          </div>
        </div>
      </div>
    </div>

  }
}

func hrefLeagueRegistration(leagueUUID uuid.UUID) templ.SafeURL {
  return templ.URL(fmt.Sprintf("/dashboard/leagues/%s/registration", leagueUUID))
}
