package league

import (
  "liga-app/infra/http/htmx/common/layouts"
	"github.com/google/uuid"
  "fmt"
  "net/url"
  "strconv"
  "liga-app/entities"
	"liga-app/enums"
)

templ PageLeagueDetail(vmodel *VModelPageLeagueDetail) {
  @layouts.DashboardLayout("Daftar Liga", vmodel.User, layouts.FOOTER_MENU_LEAGUE) {
    <div class="space-y-8">
      @ViewLeagueDetail(vmodel.League, vmodel.ShowTeamCount)
      <!-- Join Button -->
      if vmodel.Team == nil {
        <div>
          <a href={hrefLeagueRegistration(vmodel.League.UUID)} class="btn btn-primary w-full btn-lg">Daftar ke liga ini!</a>
        </div>
      } else if vmodel.League.ParticipationCategory != enums.CATEGORY_PARTICIPATION_SINGLES {
        <div class="grid grid-cols-1 gap-2">
          @ComponentCardButton("") {
            <a class="w-full" href={hrefTeamDetail(vmodel.League.UUID, vmodel.Team.UUID)}>
              <div class="flex items-center space-x-4 justify-start w-full py-4">
                <div class="avatar placeholder">
                  <div class="bg-primary text-neutral-content w-10 rounded-full">
                    <span class="text-3xl">{string(vmodel.Team.Name[0])}</span>
                  </div>
                </div>
                <div class="w-full text-left">
                  <h3 class="text-2xl">Tim {vmodel.Team.Name}</h3>
                  <h3>{strconv.Itoa(len(vmodel.Team.Players))} Pemain</h3>
                </div>
                if len(vmodel.PlayersWithRatingTooHigh) > 0 || len(vmodel.PlayersWithRatingTooLow) > 0 {
                  <div class="rounded-full bg-warning p-2">
                    <i data-feather="alert-triangle" width="18" height="18"></i>
                  </div>
                }
              </div>
            </a>
          }
          if vmodel.IsRatingRequired {
            <div role="alert" class="alert flex flex-row items-start">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                class="stroke-info h-6 w-6 shrink-0">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div class="text-left space-y-4">
                <div>
                  Anggota tim ada yang belum menerima asesmen rating untuk Season ini.
                  Seluruh anggota tim wajib menerima asesmen rating sebelum bisa bertanding.
                </div>
                <div>
                  <a class="btn btn-secondary" href={hrefWAAssessmentRequest(vmodel.League, vmodel.Team)} target="_blank">
                    <img src="/static/icons/whatsapp.png" class="w-4 h-4 mr-2" />
                    Request asesmen rating sekarang
                  </a>
                </div>
              </div>
            </div>
          }
          if len(vmodel.PlayersWithRatingTooHigh) > 0 || len(vmodel.PlayersWithRatingTooLow) > 0 {
            <div role="alert" class="alert alert-warning flex flex-row items-start">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6 shrink-0 stroke-current"
                fill="none"
                viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div class="text-left space-y-4">Rating anggota ada yg tidak sesuai dengan level di liga ini. Kontak admin di WA group untuk bantuan.</div>
            </div>
          }
        </div>
      } else if vmodel.League.ParticipationCategory == enums.CATEGORY_PARTICIPATION_SINGLES {
        if vmodel.IsRatingRequired {
          <div role="alert" class="alert flex flex-row items-start">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              class="stroke-info h-6 w-6 shrink-0">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div class="text-left space-y-4">
              <div>
                Anda belum menerima asesmen rating untuk Season ini.
                Anda wajib menerima asesmen rating sebelum bisa bertanding.
              </div>
              <div>
                <a class="btn btn-secondary" href={hrefWAAssessmentRequest(vmodel.League, vmodel.Team)} target="_blank">
                  <img src="/static/icons/whatsapp.png" class="w-4 h-4 mr-2" />
                  Request asesmen rating sekarang
                </a>
              </div>
            </div>
          </div>
        }
        if len(vmodel.PlayersWithRatingTooHigh) > 0 || len(vmodel.PlayersWithRatingTooLow) > 0 {
          <div role="alert" class="alert alert-warning flex flex-row items-start">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6 shrink-0 stroke-current"
              fill="none"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <div class="text-left space-y-4">Rating anda tidak sesuai dengan level di liga ini. Kontak admin di WA group untuk bantuan.</div>
          </div>
        }
      }

      <div>
        <div class="grid grid-cols-2 gap-2">
          // @ComponentCardButton(fmt.Sprintf("/dashboard/leagues/%s/teams", vmodel.League.UUID)) {
          @ComponentCardButton("#") {
            <div class="grid grid-row-2 gap-4 p-4">
              <div class="flex justify-center text-primary">
                <i data-feather="users" width="32" height="32"></i>
              </div>
              if vmodel.League.ParticipationCategory == enums.CATEGORY_PARTICIPATION_SINGLES {
                <h3 class="text-center">Daftar Pemain</h3>
              } else {
                <h3 class="text-center">Daftar Tim</h3>
              }
            </div>
          }
          @ComponentCardButton("#") {
            <div class="grid grid-row-2 gap-4 p-4">
              <div class="flex justify-center text-primary">
                <i data-feather="list" width="32" height="32"></i>
              </div>
              <h3 class="text-center">Daftar Pertandingan</h3>
            </div>
          }
        </div>
      </div>
    </div>

  }
}

templ ComponentCardButton(href string) {
  <a href={templ.URL(href)}>
    <div class="card w-auto btn h-full shadow-xl">
      {children...}
    </div>
  </a>
}

func hrefLeagueRegistration(leagueUUID uuid.UUID) templ.SafeURL {
  return templ.URL(fmt.Sprintf("/dashboard/leagues/%s/registration", leagueUUID))
}

func hrefTeamDetail(leagueUUID uuid.UUID, teamUUID uuid.UUID) templ.SafeURL {
  return templ.URL(fmt.Sprintf("/dashboard/leagues/%s/teams/%s", leagueUUID, teamUUID))
}

func hrefWAAssessmentRequest(league *entities.League, team *entities.Team) templ.SafeURL {
  text := ""
  if league.ParticipationCategory == enums.CATEGORY_PARTICIPATION_SINGLES {
    text = fmt.Sprintf("Halo. Saya ingin menjadwalkan asesmen rating untuk mengikuti liga %s", league.Name)
  } else {
    text = fmt.Sprintf("Halo. Saya ingin menjadwalkan asesmen rating untuk tim %s mengikuti liga %s", team.Name, league.Name)
  }
  params := url.Values{}
  params.Add("text", text)
  return templ.URL(fmt.Sprintf("https://wa.me/%s?%s", league.LinkWARatingAdmin, params.Encode()))
}
