package dashboard

import "liga-app/infra/http/htmx/common/layouts"

templ PageDashboardIndex(vmodel *VModelPageDashboardIndex) {
  @layouts.DashboardLayout("Dashboard", vmodel.User) {
    <div class="max-w-md m-auto py-4 px-4 min-h-full">
      // Rating & Match Stats ----
      <div class="grid grid-cols-2 min-h-56 gap-4">
        <div class="card bg-base-100 shadow-xl h-full">
          <div class="card-body">
            <div class="text-center">
              <h2 class="text-xl">Player Rating</h2>
            </div>
            <div class="text-center">
              <h2 class="text-lg">-</h2>
            </div>
          </div>
        </div>

        <div class="card bg-base-100 shadow-xl h-full">
          <div class="card-body">
            <div class="text-center">
              <h2 class="text-xl">Match Stats</h2>
            </div>
            <div class="text-center">
              <h2 class="text-sm">Played</h2>
              <h2 class="text-lg">0</h2>
            </div>
            <div class="grid grid-cols-2">
              <div class="text-center">
                <h2 class="text-sm">Win</h2>
                <h2 class="text-lg">0</h2>
              </div>
              <div class="text-center">
                <h2 class="text-sm">Lose</h2>
                <h2 class="text-lg">0</h2>
              </div>
            </div>
          </div>
        </div>
      </div>
      // -----------------------


      <div class="mt-12 space-y-6">
        <div>
          <h1 class="text-primary text-3xl">Your Leagues</h1>
        </div>
        <div class="text-center space-y-4">
          <p>You are not registered to a league yet..</p>
          <a hx-boost="false" href="/dashboard/leagues" class="btn btn-primary btn-wide">Join a league</a>
        </div>
      </div>
    </div>
  }
}
