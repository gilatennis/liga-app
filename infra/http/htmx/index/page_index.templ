templ PageIndex(vmodel *VModelPageIndex) {
  @layouts.LandingPageLayout("Gilatennis") {
    <!-- NavBar -->
    <div class="navbar bg-base-100">
      <div class="flex-1">
        <a href="/" class="btn btn-ghost text-xl">
          <span><h1 class="text-xl text-primary">Liga</h1></span>
          <h1 class="text-xl text-primary font-bold">Gilatennis</h1>
        </a>
      </div>
      // is not logged in
      if vmodel.User == nil {
        <div class="flex-none">
          <ul class="menu menu-horizontal px-1">
            <li><a class="text-primary" href="#">Home</a></li>
            <li><a class="text-primary" href="/auth/register">Register</a></li>
            <li><a class="text-primary" href="/auth/login">Login</a></li>
          </ul>
        </div>
      }
      // is logged in
      if vmodel.User != nil {
        <div class="flex-none gap-2">
          <div class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="flex items-center space-x-2 btn btn-ghost">
              if vmodel.User.ProfilePictureURL == "" {
                <div class="avatar placeholder">
                  <div class="bg-primary text-neutral-content w-10 rounded-full">
                    <span class="text-3xl">{string(vmodel.User.Name[0])}</span>
                  </div>
                </div>
              } else {
                <div class="avatar">
                  <div class="w-10 rounded-full">
                    <img src={vmodel.User.ProfilePictureURL} />
                  </div>
                </div>
              }
              // <h3 class="text-xl">{vmodel.User.Name}</h3>
            </div>
            // z index need to be more than drawer
            // dropdown > drawer > footer
            <ul tabindex="0" class="mt-3 z-30 p-2 shadow menu menu-sm dropdown-content bg-base-100 rounded-box w-52">
              <li>
                <a href="/dashboard/profile" class="pl-3">
                  {vmodel.User.Name}
                </a>
              </li>
              <li>
                <a href="/dashboard" class="justify-between">
                  Dashboard
                </a>
              </li>
              <li><a href="/auth/logout">Logout</a></li>
            </ul>
          </div>
        </div>
      }
    </div>

    <!-- Hero -->
    <div
      class="hero min-h-screen md:min-h-[50vh]"
      style="background-image: url(/static/images/tennis-coaching-1.webp);"
    >
      <div class="hero-overlay bg-opacity-80"></div>
      <div class="hero-content text-primary-content text-center">
        <div class="max-w-[1028px]">
          <h1 class="mb-5 text-4xl md:text-6xl font-bold">Rasakan Keseruan dan Tantangan di Liga Gilatennis</h1>
          <p class="mb-5 text-xl max-w-[980px]">
            Asah keterampilan tenis Anda melalui pertandingan seru dan bergabunglah dengan komunitas yang hidup.
            Terbuka untuk pemain di semua level!
          </p>

          <div class="space-y-4 mt-8">
            <div>
              <a href="/auth/login" class="btn btn-primary btn-wide">Daftar Sekarang!</a>
            </div>
            <div class="space-y-2">
              <p>Ada Pertanyaan?</p>
              <div class="flex items-center justify-center space-x-2 ">
                <a href="#faq" class="btn btn-secondary btn-sm">
                  <i data-feather="help-circle" class="w-4 h-4"></i>
                  F.A.Q
                </a>
                <a
                  class="btn btn-secondary btn-sm"
                  href={templ.URL(vmodel.RuleBook.Link)}
                  if vmodel.RuleBook.Link != "" {
                    target="_blank"
                  }
                >
                  <i data-feather="book-open" class="w-4 h-4"></i>
                  Buku Aturan
                </a>
                <a href={hrefWAContactUs()} target="_blank" class="btn btn-secondary btn-sm">
                  <img alt="whatsapp" src="/static/icons/whatsapp.png" class="w-4 h-4" />
                  Kontak Kami
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Section - Season 1 -->
    <div class="px-8 md:px-16 py-24">
      <div class="mb-16">
        <h1 class="text-4xl font-bold mb-2">Tennis Untuk Semua</h1>
      </div>
      <!-- Mobile Screen -->
      <div class="md:hidden grid grid-cols-1 gap-4">
        for _, f := range features {
          @CardFeature(f)
        }
      </div>
      <!-- Medium Screen and Up -->
      <div class="hidden md:grid md:grid-cols-3 md:mb-8 gap-4">
        for _, f := range features[:3] {
          @CardFeature(f)
        }
      </div>
      <div class="hidden md:grid md:grid-cols-3 gap-4 m-auto">
        for _, f := range features[3:] {
          @CardFeature(f)
        }
      </div>
    </div>

    <div id="klasemen" class="px-8 md:px-16 py-24 bg-base-200">
      @ViewKlasemen(vmodel.Leagues, vmodel.GroupStandings)
    </div>

    <div id="leaderboard" class="px-8 md:px-16 py-24 bg-base-200">
      @ViewLeaderboard(vmodel.Leagues)
    </div>

    /*
    <div
      class="hero min-h-screen md:min-h-[50vh]"
      style="background-image: url(/static/images/flyer-liga-gilatennis.png);"
    >
      <div class="hero-overlay bg-opacity-80"></div>
      <div class="hero-content text-primary-content text-center">
        <div class="max-w-[1028px]">
          <h1 class="mb-5 text-4xl md:text-6xl font-bold">Season 1 Dimulai Sekarang!</h1>
          <p class="mb-5 text-xl max-w-[980px]">
            Season 1 liga gilatennis dimulai 1 November 2024 - 28 Februari 2025.
            Pendaftaran dibuka sekarang. Pendaftaran ditutup tanggal 31 Oktober.
          </p>

          <div class="space-y-4 mt-8">
            <div>
              <a href="/auth/login" class="btn btn-primary btn-wide">Daftar Sekarang!</a>
            </div>
            <div class="space-y-2">
              <p>Ada Pertanyaan?</p>
              <div class="flex items-center justify-center space-x-2 ">
                <a href="#faq" class="btn btn-secondary btn-sm">
                  <i data-feather="help-circle" class="w-4 h-4"></i>
                  F.A.Q
                </a>
                <a
                  class="btn btn-secondary btn-sm"
                  href={templ.URL(vmodel.RuleBook.Link)}
                  if vmodel.RuleBook.Link != "" {
                    target="_blank"
                  }
                >
                  <i data-feather="book-open" class="w-4 h-4"></i>
                  Buku Aturan
                </a>
                <a href={hrefWAContactUs()} target="_blank" class="btn btn-secondary btn-sm">
                  <img alt="whatsapp" src="/static/icons/whatsapp.png" class="w-4 h-4" />
                  Kontak Kami
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    */

    <!-- F.A.Q -->
    <div id="faq" class="px-8 md:px-16 py-24 bg-base-200">
      <div class="mb-16">
        <h1 class="text-4xl font-bold mb-2">F.A.Q</h1>
      </div>
      <div>
        <div class="join join-vertical w-full">
          for i, f := range faqs {
            <div class="collapse collapse-arrow join-item border-base-300 border">
              <input
                type="radio"
                name="my-accordion-4"
                if i == 0 {
                  checked="checked"
                }
              />
              <div class="collapse-title text-xl font-medium">{f.Title}</div>
              <div class="collapse-content">
                for _, b := range f.Body {
                  if b == " " {
                    <br></br>
                  } else {
                    <p>{b}</p>
                  }
                }
              </div>
            </div>
          }
        </div>
      </div>
    </div>


    <!-- About Us -->
    <div class="px-8 md:px-16 py-24">
      <div class="mb-16">
        <h1 class="text-4xl font-bold mb-2">Tentang Kami</h1>
      </div>
      <div class="md:flex md:flex-row md:space-x-16">
        <div class="mb-8 md:mb-0 flex-[2]">
          <img alt="head-coach" class="w-full md:w-auto" src="/static/images/head-coach.jpeg"/>
        </div>
        <div class="flex flex-row flex-[3] space-x-4 mb-8 md:mb-0">
          <div class="mt-[2px]"><i data-feather="info"></i></div>
          <div>
            <h3 class="text-lg font-bold mb-2">Roy Darwis</h3>
            <p class="text-neutral">
              Head Coach and Owner Gilatennis. Mantan top 10 pemain ganda Indonesia tahun 1986-1990
            </p>
            <div class="my-8">
              <p>
                Roy Darwis, pemilik dan pelatih kepala komunitas Gilatennis,
                adalah mantan pemain tenis ganda yang pernah menempati peringkat 10 besar di Indonesia.
                Dengan pengalaman yang luas sebagai pemain profesional, pelatih, dan penyelenggara turnamen tenis, Roy membawa keahlian dan dedikasi untuk
                membantu pemain dari berbagai tingkat kemampuan meningkatkan performa mereka.
                Komitmennya terhadap pengembangan olahraga ini tidak hanya terbatas pada lapangan,
                tetapi juga dalam menciptakan komunitas tenis yang kompetitif, menyenangkan, dan inklusif
              </p>
            </div>
            <div class="my-8">
              <h3 class="font-bold mb-2">Coaching Experience</h3>
              <ul class="space-y-1 list-disc ml-6">
                for _, text := range coachingExperience {
                  <li class="text-neutral">{text}</li>
                }
              </ul>
            </div>
            <div class="my-6">
              <h3 class="font-bold mb-2">Player Experience</h3>
              <ul class="space-y-1 list-disc ml-6">
                for _, text := range playerExperience {
                  <li class="text-neutral">{text}</li>
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

  }
}



templ CardFeature(f Feature) {
<div class="card bg-base-100 w-auto shadow-xl">
  <figure class="pt-8">
    <i data-feather={f.Icon} class="w-20 h-20 text-primary"></i>
  </figure>
  <div class="card-body">
    <h2 class="card-title">
      {f.Title}
    </h2>
    <p>{f.Body}</p>
  </div>
</div>
}

func hrefWAContactUs() templ.SafeURL {
  /*
  phoneNumber := "628159239794"
  text := "Halo, saya ingin bertanya mengenai Liga Gilatennis"
  params := url.Values{}
  params.Add("text", text)
  return templ.URL(fmt.Sprintf("https://wa.me/%s?%s", phoneNumber, params.Encode()))
  */
  linkWAGroupSeason1Beginners := "https://chat.whatsapp.com/JUup3ZHCEMd1eO2WifCsI5"
  return templ.URL(linkWAGroupSeason1Beginners)
}

