var faqs = []FAQ {
  {
    Title: "Mengapa ikut liga gilatennis?",
    Body: []string {
      "Gilatennis menyelenggarakan liga tenis ini sebagai bentuk kontribusi untuk membantu mengembangkan kemampuan bermain tenis di Indonesia, dengan menciptakan lingkungan yang mendukung pembelajaran, kompetisi, dan kesenangan di setiap pertandingan.",
      " ",
      "Beberapa benefit lainya antara lain: ",
      "- Kita mensubsidi lapangan untuk pertandingan setiap hari sabtu & minggu",
      "- Diberikan 1 sesi pelatihan gratis oleh Roy Darwis (head coach) bagi pendaftar",
      "- Hadiah menarik beserta medali dan piala bergilir",
      "- Babak semifinal dan final, akan disediakan lapangan, bola, dan wasit oleh panitia.",
    },
  },
  {
    Title: "Hadiah apa bagi pemenang?",
    Body: []string {
      "Medali, dan perlengkapan tennis. Khusus untuk kategori beregu, akan ada piala bergilir",
    },
  },
  {
    Title: "Kategori apa saja yang bisa diikuti?",
    Body: []string{
      "- Singles Putra - Beginner",
      "- Singles Putri - Beginner",
      "- Doubles Putra - Beginner",
      "- Doubles Putri - Beginner",
      "- Doubles Mixed - Beginner",
      "- Beregu Putra - Beginner",
      "- Beregu Putri - Beginner",
    },
  },
  {
    Title: "Berapa biaya pendaftaran?",
    Body: []string{
      "Singles: Rp.200,000",
      "Doubles: R̶p̶.̶5̶0̶0̶,̶0̶0̶0̶ Diskon 20% -> Rp.400,000",
      "Beregu: R̶p̶.̶2̶,̶0̶0̶0̶,̶0̶0̶0̶ Diskon 25% -> Rp.1,500,000",
    },
  },
  {
    Title: "Bagaimana memastikan bahwa level partisipan sesuai dengan level yang disyaratkan (beginner)",
    Body: []string{
      "Head Coach gilatennis (Roy Darwis) akan mengunjungi langsung untuk memberikan asesmen.",
      "Jika level pemain ditetapkan lebih tinggi dari beginner, akan diberikan refund.",
      "",
      "Agar Diperhatikan: ",
      "Jika pemain berpura-pura merendahkan skill level ketika asesmen, dan terlihat bahwa skill level aslinya lebih tinggi ketika liga sudah dimulai, maka pemain akan didiskualifikasi dan tidak diberikan refund.",
    },
  },
  {
    Title: "Partai apa yang ada dalam kategori beregu?",
    Body: []string {
      "2 Doubles, 1 Singles",
    },
  },
  {
    Title: "Untuk kategori beregu, berapa jumlah pemain dalam 1 regu?",
    Body: []string{
      "Minimal 6 orang",
      "Maksimal 9 orang",
    },
  },
  {
    Title: "Berapa jumlah peserta pada sebuah kategori?",
    Body: []string{
      "Untuk kategori doubles dan beregu, minimal 6 tim, tidak ada jumlah maksimal.",
      "Untuk kategori singles minimal 6 orang, tidak ada jumlah maksimal.",
    },
  },
  {
    Title: "Apa yang terjadi jika jumlah pendaftar kurang dari jumlah minimal peserta?",
    Body: []string{
      "Uang pendaftaran akan di refund.",
    },
  },
  {
    Title: "Mengapa hanya ada kategori beginner?",
    Body: []string{
      "Untuk season 1 kami hanya menyediakan untuk level beginner. Ke depan, kami akan menambahkan kategori.",
    },
  },
  {
    Title: "Hal-hal yang perlu diperhatikan",
    Body: []string{
      "- Partisipan harus menyiapkan bola sendiri",
      "- Panitia tidak menyediakan Ball Boy",
      "- Jika ingin menggunakan lapangan yang disediakan oleh panitia, sebaiknya mendaftar lebih awal, mengingat kapasitas terbatas",
