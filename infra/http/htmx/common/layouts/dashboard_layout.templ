package layouts

import (
  "time"
  "strconv"
	"liga-app/entities"
)

type FOOTER_MENU string

const (
  FOOTER_MENU_HOME FOOTER_MENU = "home"
  FOOTER_MENU_PROFILE FOOTER_MENU = "profile"
  FOOTER_MENU_LEAGUE FOOTER_MENU = "league"
)

templ DashboardLayout(title string, user *entities.User, activeFooterMenu FOOTER_MENU) {
  <html data-theme="light">
    @Head(title)
    <!--
      tabindex="0" is required so that :focus can work on ios. (makes dropdown menu dismissable) 
      https://github.com/saadeghi/daisyui/issues/824
    -->
    <body 
      tabindex="0" 
      hx-boost="true" 
      hx-ext="response-targets" 
      class="h-screen flex flex-col"
    >
      <!-- Google Tag Manager (noscript) -->
      <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M37PLKWT"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
      <!-- End Google Tag Manager (noscript) -->

      @Navbar(user)
      @DashboardDrawer(user) {
        @ContainerMobile(){
          { children... }
        }
      }
      @DashboardFooterMenu(activeFooterMenu)
      @Scripts()
      @ScriptFeatherIcons()
    </body>
  </html>
}

templ Navbar(user *entities.User) {
  <div class="navbar fixed w-full z-10 bg-white shadow-[-1px_13px_20px_0px_rgba(0,0,0,0.25)]">
    <div class="flex flex-1">
      <label for="my-drawer"  tabindex="0" role="button" class="btn btn-ghost drawer-button">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" /></svg>
      </label>
      <div class="flex-none gap-2">
        <div class="dropdown">
          <div tabindex="0" role="button" class="flex items-center space-x-2 btn btn-ghost">
            if user.ProfilePictureURL == "" {
              <div class="avatar placeholder">
                <div class="bg-primary text-neutral-content w-10 rounded-full">
                  <span class="text-3xl">{string(user.Name[0])}</span>
                </div>
              </div>
            } else {
              <div class="avatar">
                <div class="w-10 rounded-full">
                  <img src={user.ProfilePictureURL} />
                </div>
              </div>
            }
            <h3 class="text-xl">{user.Name}</h3>
          </div>
          // z index need to be more than drawer
          // dropdown > drawer > footer
          <ul tabindex="0" class="mt-3 z-30 p-2 shadow menu menu-sm dropdown-content bg-base-100 rounded-box w-52">
            <li>
              <a href="/dashboard/profile" class="justify-between">
                Profile
              </a>
            </li>
            <li><a>Settings</a></li>
            <li><a href="/auth/logout">Logout</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
}

templ DashboardDrawer(user *entities.User) {
  <div class="drawer">
    <input id="my-drawer" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content min-h-full flex-grow overflow-auto mb-8">
      @AlertSuccess()
      @AlertError()
      <!-- Page content here -->
      { children...}
    </div>
    // z index need to be more than footer
    // dropdown > drawer > footer
    <!-- INFO: do not add bg-base-200 or any color to drawer-side. for some reason, the drawer will be full screen on mobile view -->
    <div class="drawer-side z-20">
      <label for="my-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
      <div class="bg-base-200 min-h-full">
        <!-- Sidebar content here -->
        <div class="px-8 pt-8 w-80 bg-base-200 text-base-content flex items-center space-x-2">
          <div class="pb-4 flex justify-center space-x-2">
            <span><h1 class="text-3xl text-primary">Liga</h1></span>
            <h1 class="text-3xl text-primary font-bold">Gilatennis</h1>
          </div>
        </div>
        <div class="px-8 pt-8 w-80 bg-base-200 text-base-content flex items-center space-x-2">
          <i data-feather="user" width="18" height="18" stroke-width="2"></i>
          <p class="font-bold text-sm">{user.Email}</p>
        </div>
        <!--
        <ul class="menu p-4 w-80 bg-base-200 text-base-content">
          <li><a hx-boost="true" href="/dashboard">Beranda</a></li>
          <li><a hx-boost="true" href="/dashboard/invites">Undangan</a></li>
        </ul>
        -->
      </div>
    </div>
  </div>
}

templ AlertSuccess() {
  <div id="alert-success" class="w-[350px] hidden z-20 m-4 alert alert-success transition-all fixed top-20 right-0 ">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="stroke-current shrink-0 h-6 w-6"
      fill="none"
      viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <div id="alert-success-message" class="text-left space-y-2">
    </div>
  </div>
}

templ AlertError() {
  <div id="alert-error" class="w-[350px] hidden z-20 m-4 alert alert-error transition-all fixed top-20 right-0 ">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6 shrink-0 stroke-current"
      fill="none"
      viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <div id="alert-error-message" class="text-left space-y-2">
    </div>
  </div>
}

templ DashboardFooterMenu(activeMenu FOOTER_MENU) {
  // z index need to be less than drawer
  // dropdown > drawer > footer
  <footer class="fixed w-full z-10 bg-white pt-4 pb-3 bottom-0 flex justify-center space-x-12 shadow-[-3px_-8px_20px_0px_rgba(0,0,0,0.25)]">
    @ButtonMenuDashboardFooter(ButtonMenuDashboardFooterParams{
      Icon: "user",
      Text: "Profile",
      IsActive: activeMenu == FOOTER_MENU_PROFILE,
      Href: "/dashboard/profile",
    })
    @ButtonMenuDashboardFooter(ButtonMenuDashboardFooterParams{
      Icon: "home",
      Text: "Home",
      IsActive: activeMenu == FOOTER_MENU_HOME,
      Href: "/dashboard",
    })
    @ButtonMenuDashboardFooter(ButtonMenuDashboardFooterParams{
      Icon: "layout",
      Text: "League",
      IsActive: activeMenu == FOOTER_MENU_LEAGUE,
      Href: "/dashboard/leagues",
    })
  </footer>
}

type ButtonMenuDashboardFooterParams struct {
  Icon string
  Text string
  IsActive bool
  Href string
}

templ ButtonMenuDashboardFooter(params ButtonMenuDashboardFooterParams) {
  <a href={templ.URL(params.Href)}>
    <div class="space-y-2">
      <div class="avatar placeholder btn btn-circle">
        if params.IsActive {
          <div class="ring-primary bg-primary ring-offset-base-100 w-14 rounded-full ring">
            <span class="text-3xl text-primary-content">
              <i data-feather={params.Icon} class="w-10 h-10"></i>
            </span>
          </div>
        } else {
          <div class="ring-primary ring-offset-base-100 w-14 rounded-full ring">
            <span class="text-3xl text-primary">
              <i data-feather={params.Icon} class="w-10 h-10"></i>
            </span>
          </div>
        }
      </div>
      <h3
        if params.IsActive {
          class="text-center font-bold"
        } else {
          class="text-center"
        }
      >{params.Text}</h3>
    </div>
  </a>
}

templ DashboardFooter() {
  <footer class="footer sticky top-[100vh] p-10 bg-neutral text-neutral-content">
    <nav>
      <p>© {strconv.Itoa(time.Now().Year())} - gilatennis.com</p>
    </nav> 
  </footer>
}

templ Scripts() {
  <script>
    /**
     * @typedef {Object} AlertEvent
     * @property {Object} detail
     * @property {string} detail.type
     * @property {string} detail.message
     */
    function alertHandler(event) {
      const { type, message, redirect } = event.detail

      if (type == "success") {
        const hiddenClass = "w-[350px] m-4 alert alert-success transition-all hidden fixed top-20 right-0"
        const showClass = "w-[350px] m-4 alert alert-success transition-all fixed z-20 flex flex-row items-start top-20 right-0"
        const alert = document.getElementById("alert-success")
        const alertMessage = document.getElementById("alert-success-message")
        alert.className = showClass
        alertMessage.innerText = message

        setTimeout(() => {
          alert.className = hiddenClass
        }, 2000)
      }

      if (type == "error") {
        const hiddenClass = "w-[350px] m-4 alert alert-error transition-all hidden fixed top-20 right-0"
        const showClass = "w-[350px] m-4 alert alert-error transition-all fixed z-20 flex flex-row items-start top-20 right-0"
        const alert = document.getElementById("alert-error")
        const alertMessage = document.getElementById("alert-error-message")
        alert.className = showClass
        alertMessage.innerText = message

        setTimeout(() => {
          alert.className = hiddenClass
        }, 2000)
      }

      if (redirect) {
        setTimeout(() => {
          window.location.replace(redirect);
        }, 1500)
      }
    }

    document.body.addEventListener("alert", alertHandler)
  </script>
}

