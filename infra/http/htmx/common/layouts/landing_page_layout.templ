package layouts


templ LandingPageLayout(title string) {
	<html data-theme="light" style="scroll-padding-top: 5rem; scroll-behavior: smooth;">
		@Head(title)
    <body hx-boost="true" hx-ext="response-targets" class="h-screen flex flex-col">
      <div class="container max-w-[80rem] mx-auto grow">
        { children... }
      </div>
      @BasicFooter()
      @ScriptFeatherIcons()
    </body>
	</html>
}
