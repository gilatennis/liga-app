package components

templ CardButton(href string) {
  <a href={templ.URL(href)}>
    <div class="card w-auto btn h-full shadow-xl">
      {children...}
    </div>
  </a>
}

templ CardButtonPost(url string) {
  <button hx-post={url} hx-swap="none">
    <div class="card w-auto btn h-full shadow-xl">
      {children...}
    </div>
  </button>
}
