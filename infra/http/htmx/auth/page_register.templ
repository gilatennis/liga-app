package auth

import (
  "fmt"
)

templ PageRegister(model VModelFormRegister, redirect string) {
  @pageContainer("Register") {
    @ViewFormRegister(model, redirect)
  }
}

func registerPostURL(redirect string) string {
  if redirect != "" {
    return fmt.Sprintf("/auth/register?redirect=%s", redirect)
  } else {
    return "/auth/register"
  }
}

templ ViewFormRegister(model VModelFormRegister, redirect string) {
  @container() {
    <div id="register-form"  class="card w-96 bg-base-100 shadow-xl">
      <div class="card-body space-y-6">
        <h1 class="card-title">Register</h1>
        <form
          method="POST"
          hx-post={ registerPostURL(redirect) }
          hx-select="#register-form"
          hx-swap="outerHTML"
          hx-target="#register-form"
          hx-target-400="#register-form"
          hx-target-5**="#register-form"
          class="flex-col space-y-4"
        >
          <div class="flex-col space-y-4">
            <input
              type="text"
              name="email"
              value={ model.Email }
              placeholder="Email"
              class={"input input-bordered w-full max-w-xs", templ.KV("input-error", model.FormErrors.Email != "")}
            />
            if model.FormErrors.Email != "" {
              <p class="text-error">{ model.FormErrors.Email }</p>
            }
          </div>

          if model.ServerError != "" {
            <p class="text-error">{ model.ServerError }</p>
          }

          <button class="btn btn-primary btn-wide w-full">
            Continue with email
          </button>
        </form>

        <p class="text-center">
          Already have an account? <a hx-boost="false" href="/auth/login" class="link">Login</a>
        </p>

        <div class="divider"></div>
        <div class="flex-col space-y-4">
          <a class="btn btn-neutral btn-wide w-full" hx-boost="false" href="/auth/login/oauth/google">
            <img src="/static/icons/icons8-google-48.png" class="w-4 h-4 mr-2" />
            Continue with Google
          </a>
          <a class="btn btn-neutral btn-wide w-full" hx-boost="false" href="/auth/login/oauth/facebook">
            <img src="/static/icons/icons8-facebook-48.png" class="w-4 h-4 mr-2" />
            Continue with Facebook
          </a>
        </div>
      </div>
    </div>
  }
}

templ ViewRegisterSuccess(message string) {
  @container() {
    <div id="register-form" class="card w-96 bg-base-100 shadow-xl">
      <div class="card-body space-y-8">
        <p class="text-success">{ message }</p>
      </div>
    </div>
  }
}
