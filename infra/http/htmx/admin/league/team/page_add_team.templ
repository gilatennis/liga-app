package team

import (
  "liga-app/infra/http/htmx/common/layouts"
  "liga-app/infra/http/htmx/common/components"
  "liga-app/infra/http/htmx/admin/league"
  "liga-app/entities"
  "liga-app/enums"
  // "strconv"
	"github.com/google/uuid"
  "fmt"
)

templ PageAddTeam(vmodel VModelPageAddTeam) {
  @layouts.AdminDashboardLayout("Tim", vmodel.User) {
    <div class="space-y-8">
      @league.ViewLeagueDetail(vmodel.League, true)
      if vmodel.League.ParticipationCategory == enums.CATEGORY_PARTICIPATION_SINGLES {
        @components.PageHeader("Tambah Pemain", "")
      } else {
        @components.PageHeader("Tambah Tim", "")
      }
      @ViewFormAddTeam(vmodel)
    </div>
  }
}

templ ViewFormAddTeam(vmodel VModelPageAddTeam) {
  <form
    id="form-add-team"
    hx-post={urlPostAddTeam(vmodel.League.UUID)}
    hx-swap="outerHTML"
    hx-target="#form-add-team"
    hx-target-4xx="#form-add-team"
    hx-target-5xx="#form-add-team"
  >
    if vmodel.League.ParticipationCategory == enums.CATEGORY_PARTICIPATION_SINGLES {
      <div class="text-lg pt-8">Data Pembayaran</div>
      @components.InputText(components.InputTextParams{
        Label: "Payment Amount",
        Name: "payment_amount",
      })
      @components.InputText(components.InputTextParams{
        Label: "Payment ID",
        Name: "payment_id",
      })
      <div class="text-lg pt-8">Data Pemain</div>
      @components.InputSelect(components.InputSelectParams{
        Label: "Pemain",
        Name: "[]player_uuids",
        Options: optionPlayers(vmodel.Players),
      })
    } else if vmodel.League.ParticipationCategory == enums.CATEGORY_PARTICIPATION_DOUBLES {
      <div class="text-lg pt-8">Data Pembayaran</div>
      @components.InputText(components.InputTextParams{
        Label: "Payment Amount",
        Name: "payment_amount",
      })
      @components.InputText(components.InputTextParams{
        Label: "Payment ID",
        Name: "payment_id",
      })

      <div class="text-lg pt-8">Data Pemain</div>
      @components.InputText(components.InputTextParams{
        Label: "Nama Tim",
        Name: "team_name",
      })
      @components.InputSelect(components.InputSelectParams{
        Label: "Kapten",
        Name: "[]player_uuids",
        Options: optionPlayers(vmodel.Players),
      })
      @components.InputSelect(components.InputSelectParams{
        Label: "Partner",
        Name: "[]player_uuids",
        Options: optionPlayers(vmodel.Players),
      })

    } else if vmodel.League.ParticipationCategory == enums.CATEGORY_PARTICIPATION_TEAMS {
      <div class="text-lg pt-8">Data Pembayaran</div>
      @components.InputText(components.InputTextParams{
        Label: "Payment Amount",
        Name: "payment_amount",
      })
      @components.InputText(components.InputTextParams{
        Label: "Payment ID",
        Name: "payment_id",
      })

      <div class="text-lg pt-8">Data Pemain</div>
      @components.InputText(components.InputTextParams{
        Label: "Nama Tim",
        Name: "team_name",
      })
      @components.InputSelect(components.InputSelectParams{
        Label: "Pemain #1 (Kapten)",
        Name: "[]player_uuids",
        Options: optionPlayers(vmodel.Players),
      })
      for i := 0; i < 8; i++ {
        @components.InputSelect(components.InputSelectParams{
          Label: fmt.Sprintf("Pemain #%d", i+2),
          Name: "[]player_uuids",
          Options: optionPlayers(vmodel.Players),
        })
      }
    }
    if vmodel.VModelFormAddTeam.base.ServerError != "" {
      <p class="text-error mt-1">{ vmodel.VModelFormAddTeam.base.ServerError }</p>
    }
    <div class="pt-4">
      <button class="btn btn-primary w-full">Submit</button>
    </div>
  </form>
}

func optionPlayers(players []entities.User) []components.InputSelectOption {
  options := []components.InputSelectOption{}
  for _, p := range players {
    op := components.InputSelectOption{
      Value: p.UUID.String(),
      Text: fmt.Sprintf("%s - %s - %s", p.Name, p.Gender, p.Email),
    }
    options = append(options, op)
  }

  return options
}

func urlPostAddTeam(leagueUUID uuid.UUID) string {
    return fmt.Sprintf("/admin/dashboard/leagues/%s/teams/add", leagueUUID)
  }
