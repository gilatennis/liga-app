package fixture

import (
  "liga-app/infra/http/htmx/common/layouts"
  // "strconv"
  // "liga-app/entities"
  // "liga-app/enums"
  // "time"
  // "liga-app/infra/http/htmx/common/utils"
	"liga-app/infra/http/htmx/common/components"
	"liga-app/infra/http/htmx/admin/league"
  "fmt"
  "github.com/google/uuid"
  "github.com/goodsign/monday"
	"liga-app/entities"
  "strconv"
)

templ PageGroupMatches(vmodel VModelPageGroupMatches) {
  @layouts.AdminDashboardLayout("Add Group", vmodel.User) {
    <div class="flex flex-col space-y-4">
      @league.ViewLeagueDetail(vmodel.League, true)
      @components.PageHeader(fmt.Sprintf("Group %s", vmodel.Group.Name), "")
      @ViewMatchList(vmodel)
    </div>
  }
}

templ ViewMatchList(vmodel VModelPageGroupMatches) {
  <div
    class="flex flex-col space-y-4"
    id="view-match-list"
    hx-trigger="refetch-list"
    hx-get={urlGetMatchListView(vmodel.League.UUID, vmodel.Fixture.UUID, vmodel.Group.UUID)}
    hx-include="#filter-match-list"
    hx-swap="outerHTML"
  >
    for _, m := range vmodel.Matches {
      @ViewMatchCard(m)
    }
    if vmodel.MatchesNextPage > 0 {
      <div id="load-more-replace"> 
        <button
          class="btn btn-primary w-full"
          hx-get={urlLoadMoreMatches(vmodel.League.UUID, vmodel.Fixture.UUID, vmodel.Group.UUID, vmodel.MatchesNextPage)}
          hx-target="#load-more-replace"
          hx-swap="outerHTML"
          hx-include=""
        >
          Load More
        </button>
      </div>
    }
  </div>

}

func urlGetMatchListView(leagueUUID, fixtureUUID, groupUUID uuid.UUID) string {
  return fmt.Sprintf("/admin/dashboard/leagues/%s/fixtures/%s/groups/%s/matches/view", leagueUUID, fixtureUUID, groupUUID)
}

func urlLoadMoreMatches(leagueUUID, fixtureUUID, groupUUID uuid.UUID, page int) string {
  return fmt.Sprintf("/admin/dashboard/leagues/%s/fixtures/%s/groups/%s/matches/view?page=%d", leagueUUID, fixtureUUID, groupUUID, page)
}

templ ViewMoreMatches(vmodel VModelPageGroupMatches) {
  for _, m := range vmodel.Matches {
    @ViewMatchCard(m)
  }
    if vmodel.MatchesNextPage > 0 {
    <div id="load-more-replace"> 
      <button
        class="btn btn-primary w-full"
        hx-get={urlLoadMoreMatches(vmodel.League.UUID, vmodel.Fixture.UUID, vmodel.Group.UUID, vmodel.MatchesNextPage)}
        hx-target="#load-more-replace"
        hx-swap="outerHTML"
        hx-include=""
      >
        Load More
      </button>
    </div>
  }
}

templ ViewMatchCard(m entities.Match) {
  <a
    hx-boost="false"
    if m.TeamA != nil && m.TeamB != nil {
      href={hrefMatchDetail(m.LeagueUUID, m.UUID)}
    }
  >
    <div class="card w-auto shadow-xl">
      <div class="p-4 space-y-4">
        <div class="flex flex-row">
          if m.FilterStatus == "COMPLETED" {
            <div class="flex-1 text-left text-success font-bold">{m.FilterStatus}</div>
          } else if m.FilterStatus == "NO SCHEDULE" {
            <div class="flex-1 text-left text-secondary font-bold">{m.FilterStatus}</div>
          } else {
            <div class="flex-1 text-left text-primary font-bold">{m.FilterStatus}</div>
          }
          <div class="flex-1">
            <div class="text-left text-secondary font-bold">Pertandingan ke {strconv.Itoa(m.Round.Number)}</div>
            if m.Round.Start != nil && m.Round.End != nil {
              <div class="text-xs">{monday.Format(*m.Round.Start, "02/01/2006", monday.LocaleIdID)} - {monday.Format(*m.Round.End, "02/01/2006", monday.LocaleIdID)}</div>
            }
          </div>
        </div>
        <div class="flex flex-row justify-between space-x-6 items-center">
          if m.TeamA == nil {
            <div class="w-48 text-sm">-</div>
          } else {
            <div class="flex-3 text-sm">{m.TeamA.Name}</div>
          }
          <div class="flex-1">VS</div>
          if m.TeamB == nil {
            <div class="w-48 text-sm">-</div>
          } else {
            <div class="flex-3 text-sm">{m.TeamB.Name}</div>
          }
        </div>
      </div>
    </div>
  </a>
}

func hrefMatchDetail(leagueUUID uuid.UUID, matchUUID uuid.UUID) templ.SafeURL {
  return templ.URL(fmt.Sprintf("/dashboard/leagues/%s/matches/%s", leagueUUID, matchUUID))
}
